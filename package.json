{
    "name":  "nova",
    "version":  "26.10.30",
    "description":  "Nova - a minimal, fully customizable Chromium browser with rethought tab management",
    "main":  "boot.js",
    "novaLoader":  1,
    "scripts":  {
                    "start":  "electron .",
                    "setup-ui":  "electron . --setup --src=dist/win-unpacked",
                    "icons":  "electron scripts/make-icons.js",
                    "dist":  "electron-builder --win portable"
                },
    "dependencies":  {
                         "@fontsource-variable/inter":  "^5.3.0",
                         "@ghostery/adblocker-electron":  "^2.20.1",
                         "adm-zip":  "^0.6.1",
                         "tldts-experimental":  "^7.4.18"
                     },
    "productName":  "Nova",
    "novaUpdateFeed":  "prodbycooooooollin-byte/nova",
    "author":  "Nova",
    "build":  {
                  "appId":  "app.nova.browser",
                  "productName":  "Nova",
                  "executableName":  "Nova",
                  "directories":  {
                                      "output":  "dist",
                                      "buildResources":  "build"
                                  },
                  "files":  [
                                "boot.js",
                                "main.js",
                                "extmgr.js",
                                "extbridge.js",
                                "movein.js",
                                "preload.js",
                                "updater.js",
                                "setup.js",
                                "features.js",
                                "safebrowsing.js",
                                "perms.js",
                                "iconutil.js",
                                "budget.js",
                                "persona.js",
                                "shim-preload.js",
                                "ext-shim.js",
                                "setup-preload.js",
                                "ui/**/*",
                                "build/icon.ico",
                                "build/icon.png",
                                "build/mark.svg",
                                "package.json",
                                "adblock-lists.js",
                                "assets/filters/*",
                                "yt-defuser.js",
                                "cosmetic-preload.js",
                                "scriptlet-guard.js",
                                "sleeper.js",
                                "wake-preload.js",
                                "darkmode.js",
                                "dark-preload.js",
                                "assets/darkreader/*",
                                "hub.json",
                                "changelog.json",
                                "downloader.js",
                                "wallpalette.js",
                                "webtools.js",
                                "webtools-preload.js",
                                "passwords.js",
                                "profiles.js",
                                "pwstore.js",
                                "pwcsv.js",
                                "pw-preload.js",
                                "pwcard-preload.js"
                            ],
                  "asar":  true,
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "portable",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "build/icon.ico"
                          },
                  "portable":  {
                                   "artifactName":  "Nova-Setup-${version}.exe",
                                   "splashImage":  "build/splash.bmp"
                               },
                  "artifactName":  "Nova-Setup-${version}.exe",
                  "npmRebuild":  false,
                  "extraResources":  [
                                         {
                                             "from":  "build/icon.ico",
                                             "to":  "icon.ico"
                                         }
                                     ],
                  "asarUnpack":  [
                                     "ext-shim.js"
                                 ],
                  "electronLanguages":  [
                                            "en-US",
                                            "de"
                                        ],
                  "afterPack":  "scripts/after-pack.js"
              },
    "devDependencies":  {
                            "electron":  "^41.7.1",
                            "electron-builder":  "^26.15.3",
                            "rcedit":  "^4.0.1"
                        },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/prodbycooooooollin-byte/nova.git"
                   },
    "license":  "UNLICENSED"
}

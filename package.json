{
    "name":  "nova",
    "version":  "0.7.0",
    "description":  "Nova - a minimal, fully customizable Chromium browser with rethought tab management",
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "setup-ui":  "electron . --setup --src=dist/win-unpacked",
                    "icons":  "electron scripts/make-icons.js",
                    "dist":  "electron-builder --win portable"
                },
    "dependencies":  {
                         "@fontsource-variable/inter":  "^5.3.0",
                         "@ghostery/adblocker-electron":  "^2.20.1",
                         "adm-zip":  "^0.6.1"
                     },
    "productName":  "Nova",
    "novaUpdateFeed":  "prodbycooooooollin-byte/nova",
    "author":  "Nova",
    "build":  {
                  "appId":  "app.nova.browser",
                  "productName":  "Nova",
                  "executableName":  "Nova",
                  "directories":  {
                                      "output":  "dist",
                                      "buildResources":  "build"
                                  },
                  "files":  [
                                "main.js",
                                "preload.js",
                                "updater.js",
                                "setup.js",
                                "features.js",
                                "budget.js",
                                "persona.js",
                                "shim-preload.js",
                                "setup-preload.js",
                                "ui/**/*",
                                "build/icon.ico",
                                "build/icon.png",
                                "build/mark.svg",
                                "package.json"
                            ],
                  "asar":  true,
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "portable",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "build/icon.ico"
                          },
                  "portable":  {
                                   "artifactName":  "Nova-Setup-${version}.exe"
                               },
                  "artifactName":  "Nova-Setup-${version}.exe",
                  "npmRebuild":  false
              },
    "devDependencies":  {
                            "electron":  "^41.7.1",
                            "electron-builder":  "^26.15.3",
                            "rcedit":  "^4.0.1"
                        },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/prodbycooooooollin-byte/nova.git"
                   },
    "license":  "UNLICENSED"
}
